# Unified Fastify 5 Backend Environment Configuration
HOST=0.0.0.0
PORT=4000
# Generate strong random secrets (e.g. openssl rand -hex 32)
JWT_SECRET=
PUBLIC_BACKEND_URL=http://localhost:4000

# AI Service Engine & Cloud VTON Keys
AI_SERVICE_URL=http://localhost:8000
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
FAL_KEY=

# Database Configuration (Supabase PostgreSQL / Neon PostgreSQL)
DATABASE_URL=
DIRECT_URL=

# Optional Supabase Auth & Private Storage Buckets
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
STORAGE_DRIVER=auto

# RabbitMQ & Redis (Required for horizontal async job workers)
RABBITMQ_URL=
REDIS_URL=

# Cloudinary Image Storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=virtual-try-on

# Resend Email Delivery (Account Verification & Password Reset)
RESEND_API_KEY=
RESEND_FROM=V-TRY Studio . noreply@vtrystudio.com

# Google OAuth Verification (must match marketplace GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=

# Super admin seed credentials (only platform root admin seeded)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Allowed frontend origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
