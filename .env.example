# Unified Fastify 5 Backend Environment Configuration
HOST=0.0.0.0
PORT=4000

# Security & Tokens
JWT_SECRET=vton_unified_jwt_secret_production_ready_2026
PASSWORD_SALT=vton_production_salt_secure_2026
INTERNAL_SERVICE_KEY=vton_internal_service_key_enterprise

# AI Service Engine (Local FastAPI Engine)
AI_SERVICE_URL=http://localhost:8000

# =============================================================
# External AI Virtual Try-On API (Cloud Provider)
# =============================================================
# Simply paste your VTON API Key below!
# Compatible with:
#  - Gemini: GEMINI_API_KEY
#  - Fal.ai: FAL_KEY (recommended) or VTON_API_KEY
#  - Fashn.ai: paste your Fashn API key in VTON_API_KEY
#  - Replicate: paste your Replicate API token (r8_...) in VTON_API_KEY
#  - Kling AI / Segmind / Custom: paste your API key in VTON_API_KEY and endpoint in VTON_API_URL
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
FAL_KEY=
VTON_API_KEY=
VTON_API_URL=
VTON_PROVIDER=auto

# Database Configuration (Neon Serverless PostgreSQL or local Postgres)
DATABASE_URL=

# Cloudinary Image Storage
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=virtual-try-on
