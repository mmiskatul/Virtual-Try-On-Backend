# Unified Fastify 5 Backend Environment Configuration

# Server Ports
HOST=0.0.0.0
PORT=4000
BRAND_API_PORT=4001
MARKETPLACE_API_PORT=4002
SUPER_ADMIN_API_PORT=4003

# Security & Tokens
JWT_SECRET=vton_unified_jwt_secret_production_ready_2026
PASSWORD_SALT=vton_production_salt_secure_2026
INTERNAL_SERVICE_KEY=vton_internal_service_key_enterprise

# AI Service Engine
AI_SERVICE_URL=http://localhost:8000

# Database Configuration (Neon Serverless PostgreSQL or local Postgres)
# Leave empty to run with high-performance in-memory persistence and snapshotting
DATABASE_URL=
# Example: postgresql://neondb_owner:password@ep-cool-snowflake-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Cloudinary Image Storage (for product images, fabrics, garments, and try-on results)
# You can provide CLOUDINARY_URL or individual credentials
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=virtual-try-on
