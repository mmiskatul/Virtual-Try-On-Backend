# Unified Fastify 5 Backend Environment Configuration
HOST=0.0.0.0
PORT=4000
JWT_SECRET=change_me_min_32_char_secret_key_for_prod
INTERNAL_SERVICE_KEY=change_me_internal_service_key_32chars
PUBLIC_BACKEND_URL=http://localhost:4000

# AI Service Engine & Cloud VTON Keys
AI_SERVICE_URL=http://localhost:8000
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
FAL_KEY=

# Database Configuration (Supabase PostgreSQL / Neon PostgreSQL)
DATABASE_URL=
DIRECT_URL=

# Optional Supabase Auth & Private Storage Buckets
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
STORAGE_DRIVER=auto

# RabbitMQ & Redis (Required for horizontal async job workers)
RABBITMQ_URL=
REDIS_URL=

# Cloudinary Image Storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=virtual-try-on

# SMTP Email Delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=V-TRY Studio <noreply@v-try.fashion>

# Super admin seed credentials (only platform root admin seeded)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Allowed frontend origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
