# Unified Fastify 5 Backend Environment Configuration
HOST=0.0.0.0
PORT=4000
# Generate strong random secrets (e.g. openssl rand -hex 32)
JWT_SECRET=
PUBLIC_BACKEND_URL=http://localhost:4000

# AI Service Engine & Cloud VTON Keys
AI_SERVICE_URL=http://localhost:8000
# Shared secret between this backend and the AI service (must be identical in both). openssl rand -hex 32
INTERNAL_SERVICE_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
FAL_KEY=
FAL_MODEL=blackforestlabs/flux-3/klein/edit-image
# auto = fal first, Gemini as fallback | fal = fal only | gemini = Gemini only
TRYON_PROVIDER=auto

# Database Configuration (Supabase PostgreSQL / Neon PostgreSQL)
DATABASE_URL=
DIRECT_URL=

# Optional Supabase Auth & Private Storage Buckets
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
STORAGE_DRIVER=auto

# RabbitMQ & Redis (Required for horizontal async job workers)
RABBITMQ_URL=
REDIS_URL=

# Cloudinary Image Storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=virtual-try-on

# Resend Email Delivery (Account Verification & Password Reset)
RESEND_API_KEY=
RESEND_FROM=V-TRY Studio . noreply@vtrystudio.com

# Google OAuth Verification (must match marketplace GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=

# Super admin: signs in with Google. Put YOUR Google email here; it is the only account that can enter the admin console.
# The same GOOGLE_CLIENT_ID above is used to check the Google token.
SEED_ADMIN_EMAIL=
# Optional: extra Google emails allowed as super admin (comma-separated)
SUPER_ADMIN_EMAILS=
# Leave EMPTY in production (Google only). Setting it re-enables email + password sign-in for the admin account.
SEED_ADMIN_PASSWORD=

# Allowed frontend origins (comma-separated)
# Official vtrystudio.com origins are built in; add EXTRA origins here (comma-separated).
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
# Production only (shares auth cookies across subdomains): COOKIE_DOMAIN=.vtrystudio.com

# Reverse proxy / docs
# TRUST_PROXY=true   (default in production; set false if the API is exposed directly)
# ENABLE_DOCS=true   (API docs are off in production by default)
