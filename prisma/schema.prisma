generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// EXISTING CORE TABLES (Preserved backward-compatible for active runtime & tests)
// ============================================================================

// 1. Tenants Table
model Tenant {
  id                 String        @id @db.VarChar(64)
  name               String        @db.VarChar(255)
  slug               String        @unique @db.VarChar(255)
  status             String        @default("ACTIVE") @db.VarChar(32)
  logoUrl            String?       @map("logo_url") @db.Text
  bannerUrl          String?       @map("banner_url") @db.Text
  description        String?       @db.Text
  contactEmail       String        @map("contact_email") @db.VarChar(255)
  storefrontSettings Json?         @map("storefront_settings")
  createdAt          BigInt        @map("created_at")
  updatedAt          BigInt        @map("updated_at")

  users              User[]
  products           Product[]
  fabrics            Fabric[]
  subscription       Subscription?
  orders             Order[]
  generationJobs     GenerationJob[]

  // Enterprise Phase 1+ Relations
  members            TenantMember[]
  invitations        Invitation[]
  categories         Category[]
  collections        Collection[]
  creditAccount      AiCreditAccount?
  creditLedger       AiCreditLedger[]
  costRecords        AiCostRecord[]
  invoices           InvoiceRecord[]
  payments           PaymentRecord[]
  discounts          DiscountCode[]
  supportTickets     SupportTicket[]
  webhookEndpoints   WebhookEndpoint[]
  viewAsSessions     ViewAsSession[]
  dataRequests       DataGovernanceRequest[]
  featureOverrides   TenantFeatureOverride[]
  carts              Cart[]
  reviews            Review[]

  @@index([status])
  @@map("tenants")
}

// 2. Users Table (Fastify local Auth fallback; Supabase users link via UserProfile.authUserId)
model User {
  id              String      @id @db.VarChar(64)
  tenantId        String?     @map("tenant_id") @db.VarChar(64)
  tenant          Tenant?     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name            String      @db.VarChar(255)
  email           String      @unique @db.VarChar(255)
  passwordHash    String      @map("password_hash") @db.VarChar(255)
  role            String      @db.VarChar(64)
  emailVerified   Boolean     @default(false) @map("email_verified")
  emailVerifiedAt BigInt?     @map("email_verified_at")
  updatedAt       BigInt?     @map("updated_at")
  createdAt       BigInt      @map("created_at")

  authTokens      AuthToken[]
  profile         UserProfile?
  sessions        UserSession[]

  @@index([tenantId])
  @@index([email])
  @@map("users")
}

// 3. Products Table
model Product {
  id                       String   @id @db.VarChar(64)
  tenantId                 String   @map("tenant_id") @db.VarChar(64)
  tenant                   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name                     String   @db.VarChar(255)
  slug                     String   @db.VarChar(255)
  description              String?  @db.Text
  category                 String   @db.VarChar(128)
  subCategory              String?  @map("sub_category") @db.VarChar(128)
  collection               String?  @db.VarChar(128)
  sku                      String   @db.VarChar(128)
  price                    Float
  compareAtPrice           Float?   @map("compare_at_price")
  images                   Json     @default("[]")
  fabricIds                Json     @default("[]") @map("fabric_ids")
  tags                     Json     @default("[]")
  brandStorefrontPublished Boolean  @default(true) @map("brand_storefront_published")
  marketplacePublished     Boolean  @default(false) @map("marketplace_published")
  isTryOnEligible          Boolean  @default(true) @map("is_try_on_eligible")
  tryOnCategory            String   @default("tops") @map("try_on_category") @db.VarChar(64)
  specs                    Json?
  variants                 Json     @default("[]")
  createdAt                BigInt   @map("created_at")
  updatedAt                BigInt   @map("updated_at")

  variantRecords           ProductVariantRecord[]
  productImages            ProductImage[]
  publication              MarketplacePublication?
  reviews                  Review[]
  favorites                Favorite[]

  @@index([tenantId])
  @@index([marketplacePublished])
  @@map("products")
}

// 4. Fabrics Table
model Fabric {
  id               String   @id @db.VarChar(64)
  tenantId         String   @map("tenant_id") @db.VarChar(64)
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name             String   @db.VarChar(255)
  composition      String   @db.VarChar(255)
  color            String   @db.VarChar(128)
  pattern          String   @db.VarChar(128)
  weightGsm        Int?     @map("weight_gsm")
  stretch          String?  @db.VarChar(32)
  transparency     String?  @db.VarChar(32)
  thickness        String?  @db.VarChar(32)
  careInstructions String?  @map("care_instructions") @db.Text
  textureUrl       String?  @map("texture_url") @db.Text
  createdAt        BigInt   @map("created_at")

  @@index([tenantId])
  @@map("fabrics")
}

// 5. Subscriptions Table
model Subscription {
  id                String  @id @db.VarChar(64)
  tenantId          String  @unique @map("tenant_id") @db.VarChar(64)
  tenant            Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan              String  @default("STARTER") @db.VarChar(64)
  planId            String? @map("plan_id") @db.VarChar(64)
  productLimit      Int     @default(50) @map("product_limit")
  tryOnMonthlyQuota Int     @default(500) @map("try_on_monthly_quota")
  tryOnUsed         Int     @default(0) @map("try_on_used")
  status            String  @default("ACTIVE") @db.VarChar(32)
  billingInterval   String  @default("MONTHLY") @map("billing_interval") @db.VarChar(16)
  trialEndsAt       DateTime? @map("trial_ends_at") @db.Timestamptz
  currentPeriodEnd  DateTime? @map("current_period_end") @db.Timestamptz
  updatedAt         BigInt  @map("updated_at")

  planRecord        Plan?   @relation(fields: [planId], references: [id], onDelete: SetNull)
  events            SubscriptionEvent[]

  @@map("subscriptions")
}

// 6. Orders Table
model Order {
  id              String   @id @db.VarChar(64)
  tenantId        String   @map("tenant_id") @db.VarChar(64)
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId      String?  @map("customer_id") @db.VarChar(64)
  customerEmail   String   @map("customer_email") @db.VarChar(255)
  status          String   @default("PENDING") @db.VarChar(64)
  totalAmount     Float    @map("total_amount")
  subtotal        Float
  shippingFee     Float    @default(0) @map("shipping_fee")
  shippingAddress Json?    @map("shipping_address")
  items           Json     @default("[]")
  paymentStatus   String   @default("PENDING") @map("payment_status") @db.VarChar(64)
  createdAt       BigInt   @map("created_at")
  updatedAt       BigInt   @map("updated_at")

  orderItems      OrderItemRecord[]
  payments        PaymentRecord[]

  @@index([tenantId])
  @@index([customerEmail])
  @@map("orders")
}

// 7. Inventory Logs Table
model InventoryLog {
  id         String @id @db.VarChar(64)
  tenantId   String @map("tenant_id") @db.VarChar(64)
  productId  String @map("product_id") @db.VarChar(64)
  variantSku String @map("variant_sku") @db.VarChar(128)
  change     Int
  newStock   Int    @map("new_stock")
  reason     String @db.Text
  timestamp  BigInt

  @@index([tenantId])
  @@map("inventory_logs")
}

// 8. Audit Logs Table (Append-only Governance & Security Ledger)
model AuditLog {
  id            String   @id @db.VarChar(64)
  tenantId      String?  @map("tenant_id") @db.VarChar(64)
  actorId       String   @map("actor_id") @db.VarChar(255)
  actorRole     String   @map("actor_role") @db.VarChar(64)
  action        String   @db.VarChar(128)
  entity        String   @db.VarChar(128)
  entityId      String?  @map("entity_id") @db.VarChar(255)
  reason        String?  @db.Text
  correlationId String?  @map("correlation_id") @db.VarChar(128)
  ipMasked      String?  @map("ip_masked") @db.VarChar(64)
  details       Json?
  timestamp     BigInt

  @@index([timestamp])
  @@index([tenantId, timestamp])
  @@index([actorId, timestamp])
  @@map("audit_logs")
}

// 9. Auth Tokens Table (Email Verification & Password Reset)
model AuthToken {
  id          String  @id @db.VarChar(64)
  userId      String  @map("user_id") @db.VarChar(64)
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  email       String  @db.VarChar(255)
  type        String  @db.VarChar(32)
  tokenHash   String  @map("token_hash") @db.VarChar(128)
  otpCodeHash String? @map("otp_code_hash") @db.VarChar(128)
  portal      String  @default("marketplace") @db.VarChar(32)
  expiresAt   BigInt  @map("expires_at")
  usedAt      BigInt? @map("used_at")
  createdAt   BigInt  @map("created_at")

  @@index([userId])
  @@index([email])
  @@index([tokenHash])
  @@map("auth_tokens")
}

// 10. Generation Jobs Table (Authoritative Try-On Request Lifecycle)
model GenerationJob {
  id              String  @id @db.VarChar(64)
  tenantId        String  @map("tenant_id") @db.VarChar(64)
  tenant          Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId          String? @map("user_id") @db.VarChar(64)
  productId       String  @map("product_id") @db.VarChar(64)
  category        String  @db.VarChar(64)
  status          String  @default("QUEUED") @db.VarChar(32)
  accessTokenHash String  @map("access_token_hash") @db.VarChar(128)
  idempotencyKey  String? @map("idempotency_key") @db.VarChar(128)
  providerJobId   String? @map("provider_job_id") @db.VarChar(128)
  modelKey        String? @map("model_key") @db.VarChar(64)
  modelVersion    String? @map("model_version") @db.VarChar(64)
  personBucket    String? @map("person_bucket") @db.VarChar(64)
  personObjectKey String? @map("person_object_key") @db.Text
  garmentBucket   String? @map("garment_bucket") @db.VarChar(64)
  garmentObjectKey String? @map("garment_object_key") @db.Text
  resultBucket    String? @map("result_bucket") @db.VarChar(64)
  resultObjectKey String? @map("result_object_key") @db.Text
  correlationId   String? @map("correlation_id") @db.VarChar(128)
  errorCode       String? @map("error_code") @db.VarChar(64)
  errorMessage    String? @map("error_message") @db.Text
  latencyMs       Int?    @map("latency_ms")
  retryCount      Int     @default(0) @map("retry_count")
  createdAt       BigInt  @map("created_at")
  updatedAt       BigInt  @map("updated_at")

  costRecords     AiCostRecord[]

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status])
  @@index([userId])
  @@index([providerJobId])
  @@map("generation_jobs")
}

// 11. Usage Ledger
model UsageLedger {
  id            String @id @db.VarChar(64)
  generationId  String @unique @map("generation_id") @db.VarChar(64)
  tenantId      String @map("tenant_id") @db.VarChar(64)
  billingPeriod String @map("billing_period") @db.VarChar(16)
  reservedUnits Int    @map("reserved_units")
  finalUnits    Int?   @map("final_units")
  status        String @default("RESERVED") @db.VarChar(32)
  createdAt     BigInt @map("created_at")
  updatedAt     BigInt @map("updated_at")

  @@index([tenantId, billingPeriod])
  @@map("usage_ledger")
}

// ============================================================================
// PHASE 1+ NORMALIZED ENTERPRISE RELATIONAL MODELS (Timestamptz + Decimal)
// ============================================================================

model UserProfile {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @unique @map("user_id") @db.VarChar(64)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  authUserId  String?  @unique @map("auth_user_id") @db.VarChar(128)
  displayName String   @map("display_name") @db.VarChar(255)
  phone       String?  @db.VarChar(32)
  avatarUrl   String?  @map("avatar_url") @db.Text
  status      String   @default("ACTIVE") @db.VarChar(32)
  mfaEnabled  Boolean  @default(false) @map("mfa_enabled")
  consentVton Boolean  @default(false) @map("consent_vton")
  consentTrain Boolean @default(false) @map("consent_train")
  lastLoginAt DateTime? @map("last_login_at") @db.Timestamptz
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  roleAssignments UserRoleAssignment[]
  memberships     TenantMember[]
  uploads         CustomerUpload[]
  favorites       Favorite[]
  reviews         Review[]
  notifications   Notification[]

  @@map("user_profiles")
}

model UserSession {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.VarChar(64)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceLabel  String   @map("device_label") @db.VarChar(255)
  ipMasked     String?  @map("ip_masked") @db.VarChar(64)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz
  expiresAt    DateTime @map("expires_at") @db.Timestamptz
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([userId, revokedAt])
  @@map("user_sessions")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(64)
  name        String   @db.VarChar(128)
  description String?  @db.Text
  isSystem    Boolean  @default(false) @map("is_system")
  mfaRequired Boolean  @default(false) @map("mfa_required")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  permissions RolePermission[]
  assignments UserRoleAssignment[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  module      String   @db.VarChar(64)
  action      String   @db.VarChar(64)
  description String?  @db.Text

  roles       RolePermission[]

  @@unique([module, action])
  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRoleAssignment {
  id            String      @id @default(uuid()) @db.Uuid
  userProfileId String      @map("user_profile_id") @db.Uuid
  roleId        String      @map("role_id") @db.Uuid
  tenantId      String?     @map("tenant_id") @db.VarChar(64)
  userProfile   UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
  role          Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz

  @@unique([userProfileId, roleId, tenantId])
  @@index([tenantId])
  @@map("user_role_assignments")
}

model TenantMember {
  id            String      @id @default(uuid()) @db.Uuid
  tenantId      String      @map("tenant_id") @db.VarChar(64)
  userProfileId String      @map("user_profile_id") @db.Uuid
  roleCode      String      @map("role_code") @db.VarChar(64)
  status        String      @default("ACTIVE") @db.VarChar(32)
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userProfile   UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
  joinedAt      DateTime    @default(now()) @map("joined_at") @db.Timestamptz

  @@unique([tenantId, userProfileId])
  @@map("tenant_members")
}

model Invitation {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String?  @map("tenant_id") @db.VarChar(64)
  tenant     Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email      String   @db.VarChar(255)
  roleCode   String   @map("role_code") @db.VarChar(64)
  tokenHash  String   @unique @map("token_hash") @db.VarChar(128)
  status     String   @default("PENDING") @db.VarChar(32)
  expiresAt  DateTime @map("expires_at") @db.Timestamptz
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([tenantId, status])
  @@map("invitations")
}

model ViewAsSession {
  id         String   @id @default(uuid()) @db.Uuid
  adminId    String   @map("admin_id") @db.VarChar(64)
  tenantId   String   @map("tenant_id") @db.VarChar(64)
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  mode       String   @default("READ_ONLY") @db.VarChar(32)
  reason     String   @db.Text
  startedAt  DateTime @default(now()) @map("started_at") @db.Timestamptz
  expiresAt  DateTime @map("expires_at") @db.Timestamptz
  endedAt    DateTime? @map("ended_at") @db.Timestamptz

  @@index([tenantId, startedAt])
  @@map("view_as_sessions")
}

// --- Normalized Catalog & Marketplace Tables ---

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String?  @map("tenant_id") @db.VarChar(64)
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String   @db.VarChar(128)
  slug      String   @db.VarChar(128)
  sortOrder Int      @default(0) @map("sort_order")
  active    Boolean  @default(true)
  seoTitle  String?  @map("seo_title") @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([tenantId, slug])
  @@map("categories")
}

model Collection {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String?  @map("tenant_id") @db.VarChar(64)
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title       String   @db.VarChar(128)
  slug        String   @db.VarChar(128)
  description String?  @db.Text
  active      Boolean  @default(true)
  sponsored   Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([tenantId, slug])
  @@map("collections")
}

model ProductVariantRecord {
  id            String   @id @default(uuid()) @db.Uuid
  productId     String   @map("product_id") @db.VarChar(64)
  tenantId      String   @map("tenant_id") @db.VarChar(64)
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku           String   @db.VarChar(128)
  size          String   @db.VarChar(32)
  color         String   @db.VarChar(64)
  colorHex      String?  @map("color_hex") @db.VarChar(16)
  priceOverride Decimal? @map("price_override") @db.Decimal(12, 2)
  stockQuantity Int      @default(0) @map("stock_quantity")
  reservedQty   Int      @default(0) @map("reserved_qty")
  available     Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  cartItems     CartItem[]
  orderItems    OrderItemRecord[]

  @@unique([tenantId, sku])
  @@index([productId])
  @@map("product_variants")
}

model ProductImage {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @map("product_id") @db.VarChar(64)
  tenantId  String   @map("tenant_id") @db.VarChar(64)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  bucket    String   @db.VarChar(64)
  objectKey String   @map("object_key") @db.Text
  sortOrder Int      @default(0) @map("sort_order")
  isPrimary Boolean  @default(false) @map("is_primary")
  aiReady   Boolean  @default(false) @map("ai_ready")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([productId])
  @@map("product_images")
}

model MarketplacePublication {
  id               String   @id @default(uuid()) @db.Uuid
  productId        String   @unique @map("product_id") @db.VarChar(64)
  tenantId         String   @map("tenant_id") @db.VarChar(64)
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  status           String   @default("DRAFT") @db.VarChar(32)
  moderationStatus String   @default("APPROVED") @map("moderation_status") @db.VarChar(32)
  moderationNote   String?  @map("moderation_note") @db.Text
  featured         Boolean  @default(false)
  sponsored        Boolean  @default(false)
  publishedAt      DateTime? @map("published_at") @db.Timestamptz
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([productId, tenantId])
  @@index([tenantId, status])
  @@index([moderationStatus, featured])
  @@map("marketplace_publications")
}

model Favorite {
  id            String      @id @default(uuid()) @db.Uuid
  userProfileId String      @map("user_profile_id") @db.Uuid
  productId     String      @map("product_id") @db.VarChar(64)
  userProfile   UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz

  @@unique([userProfileId, productId])
  @@map("favorites")
}

model Review {
  id            String      @id @default(uuid()) @db.Uuid
  tenantId      String      @map("tenant_id") @db.VarChar(64)
  productId     String      @map("product_id") @db.VarChar(64)
  userProfileId String      @map("user_profile_id") @db.Uuid
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  userProfile   UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
  rating        Int
  comment       String      @db.Text
  verifiedBuy   Boolean     @default(false) @map("verified_buy")
  brandReply    String?     @map("brand_reply") @db.Text
  reported      Boolean     @default(false)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz

  @@index([tenantId, productId])
  @@map("reviews")
}

// --- Commerce, Payments, Refunds & Discounts (Decimal Financial Precision) ---

model Cart {
  id        String     @id @default(uuid()) @db.Uuid
  tenantId  String     @map("tenant_id") @db.VarChar(64)
  userId    String     @map("user_id") @db.VarChar(64)
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  items     CartItem[]

  @@unique([tenantId, userId])
  @@map("carts")
}

model CartItem {
  id        String               @id @default(uuid()) @db.Uuid
  cartId    String               @map("cart_id") @db.Uuid
  variantId String               @map("variant_id") @db.Uuid
  cart      Cart                 @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant   ProductVariantRecord @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int

  @@unique([cartId, variantId])
  @@map("cart_items")
}

model OrderItemRecord {
  id          String                @id @default(uuid()) @db.Uuid
  orderId     String                @map("order_id") @db.VarChar(64)
  variantId   String?               @map("variant_id") @db.Uuid
  order       Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant     ProductVariantRecord? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  productName String                @map("product_name") @db.VarChar(255)
  sku         String                @db.VarChar(128)
  quantity    Int
  unitPrice   Decimal               @map("unit_price") @db.Decimal(12, 2)
  lineTotal   Decimal               @map("line_total") @db.Decimal(12, 2)

  @@index([orderId])
  @@map("order_items")
}

model PaymentRecord {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.VarChar(64)
  orderId        String?  @map("order_id") @db.VarChar(64)
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order          Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  provider       String   @db.VarChar(64)
  providerRef    String   @unique @map("provider_ref") @db.VarChar(128)
  amount         Decimal  @db.Decimal(12, 2)
  currency       String   @default("BDT") @db.VarChar(8)
  status         String   @db.VarChar(32)
  failureReason  String?  @map("failure_reason") @db.Text
  idempotencyKey String?  @unique @map("idempotency_key") @db.VarChar(128)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  refunds        RefundRecord[]

  @@index([tenantId, status])
  @@map("payments")
}

model RefundRecord {
  id          String        @id @default(uuid()) @db.Uuid
  paymentId   String        @map("payment_id") @db.Uuid
  payment     PaymentRecord @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  amount      Decimal       @db.Decimal(12, 2)
  reason      String        @db.Text
  status      String        @default("REQUESTED") @db.VarChar(32)
  providerRef String?       @map("provider_ref") @db.VarChar(128)
  approvedBy  String?       @map("approved_by") @db.VarChar(64)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz

  @@map("refunds")
}

model DiscountCode {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String?  @map("tenant_id") @db.VarChar(64)
  tenant        Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code          String   @db.VarChar(64)
  type          String   @db.VarChar(32)
  value         Decimal  @db.Decimal(12, 2)
  minOrderValue Decimal  @default(0) @map("min_order_value") @db.Decimal(12, 2)
  usageCount    Int      @default(0) @map("usage_count")
  usageLimit    Int      @default(100) @map("usage_limit")
  active        Boolean  @default(true)
  expiresAt     DateTime? @map("expires_at") @db.Timestamptz
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([tenantId, code])
  @@map("discounts")
}

// --- SaaS Plans, Entitlements & Invoices ---

model Plan {
  id            String            @id @db.VarChar(64)
  slug          String            @unique @db.VarChar(64)
  name          String            @db.VarChar(128)
  description   String?           @db.Text
  monthlyPrice  Decimal           @map("monthly_price") @db.Decimal(12, 2)
  annualPrice   Decimal           @map("annual_price") @db.Decimal(12, 2)
  currency      String            @default("BDT") @db.VarChar(8)
  trialDays     Int               @default(14) @map("trial_days")
  publicVisible Boolean           @default(true) @map("public_visible")
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz

  entitlements  PlanEntitlement[]
  subscriptions Subscription[]

  @@map("plans")
}

model PlanEntitlement {
  id         String  @id @default(uuid()) @db.Uuid
  planId     String  @map("plan_id") @db.VarChar(64)
  plan       Plan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  featureKey String  @map("feature_key") @db.VarChar(64)
  state      String  @default("ENABLED") @db.VarChar(32)
  limitValue Int?    @map("limit_value")

  @@unique([planId, featureKey])
  @@map("plan_entitlements")
}

model SubscriptionEvent {
  id             String       @id @default(uuid()) @db.Uuid
  subscriptionId String       @map("subscription_id") @db.VarChar(64)
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  eventType      String       @map("event_type") @db.VarChar(64)
  metadata       Json?
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz

  @@index([subscriptionId, createdAt])
  @@map("subscription_events")
}

model InvoiceRecord {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.VarChar(64)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoiceNo String   @unique @map("invoice_no") @db.VarChar(64)
  period    String   @db.VarChar(32)
  subtotal  Decimal  @db.Decimal(12, 2)
  taxAmount Decimal  @default(0) @map("tax_amount") @db.Decimal(12, 2)
  total     Decimal  @db.Decimal(12, 2)
  currency  String   @default("BDT") @db.VarChar(8)
  status    String   @default("OPEN") @db.VarChar(32)
  dueDate   DateTime @map("due_date") @db.Timestamptz
  issuedAt  DateTime @default(now()) @map("issued_at") @db.Timestamptz

  @@index([tenantId, status])
  @@map("invoices")
}

// --- Private Customer Uploads, AI Registry & Atomic Credit Accounting ---

model CustomerUpload {
  id            String       @id @default(uuid()) @db.Uuid
  userProfileId String?      @map("user_profile_id") @db.Uuid
  userProfile   UserProfile? @relation(fields: [userProfileId], references: [id], onDelete: SetNull)
  bucket        String       @db.VarChar(64)
  objectKey     String       @unique @map("object_key") @db.Text
  contentType   String       @map("content_type") @db.VarChar(64)
  sizeBytes     Int          @map("size_bytes")
  consentGiven  Boolean      @default(false) @map("consent_given")
  expiresAt     DateTime     @map("expires_at") @db.Timestamptz
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz

  @@index([userProfileId])
  @@map("customer_uploads")
}

model AiProviderRecord {
  id             String          @id @db.VarChar(64)
  name           String          @db.VarChar(128)
  category       String          @db.VarChar(32)
  enabled        Boolean         @default(true)
  status         String          @default("HEALTHY") @db.VarChar(32)
  avgLatencyMs   Int             @default(0) @map("avg_latency_ms")
  errorRatePct   Float           @default(0) @map("error_rate_pct")
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  models         AiModelRecord[]

  @@map("ai_providers")
}

model AiModelRecord {
  id                   String           @id @db.VarChar(64)
  providerId           String           @map("provider_id") @db.VarChar(64)
  provider             AiProviderRecord @relation(fields: [providerId], references: [id], onDelete: Cascade)
  name                 String           @db.VarChar(128)
  version              String           @db.VarChar(64)
  category             String           @db.VarChar(64)
  resolution           String           @db.VarChar(32)
  requiredEntitlement  String           @map("required_entitlement") @db.VarChar(64)
  estCostUsd           Decimal          @map("est_cost_usd") @db.Decimal(12, 4)
  active               Boolean          @default(true)
  isDefault            Boolean          @default(false) @map("is_default")
  updatedAt            DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  @@map("ai_models")
}

model AiCreditAccount {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @unique @map("tenant_id") @db.VarChar(64)
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  availableCredits Int      @default(0) @map("available_credits")
  reservedCredits  Int      @default(0) @map("reserved_credits")
  promoCredits     Int      @default(0) @map("promo_credits")
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("ai_credit_accounts")
}

model AiCreditLedger {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.VarChar(64)
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type           String   @db.VarChar(32)
  delta          Int
  balanceAfter   Int      @map("balance_after")
  reason         String   @db.Text
  actor          String   @db.VarChar(128)
  referenceId    String   @map("reference_id") @db.VarChar(128)
  idempotencyKey String?  @unique @map("idempotency_key") @db.VarChar(128)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([tenantId, createdAt])
  @@map("ai_credit_ledger")
}

model AiCostRecord {
  id              String        @id @default(uuid()) @db.Uuid
  tenantId        String        @map("tenant_id") @db.VarChar(64)
  generationJobId String        @map("generation_job_id") @db.VarChar(64)
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  generationJob   GenerationJob @relation(fields: [generationJobId], references: [id], onDelete: Cascade)
  providerId      String        @map("provider_id") @db.VarChar(64)
  modelKey        String        @map("model_key") @db.VarChar(64)
  estProviderUsd  Decimal       @map("est_provider_usd") @db.Decimal(12, 4)
  billedCredits   Int           @map("billed_credits")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz

  @@index([tenantId, createdAt])
  @@map("ai_cost_records")
}

// --- Transactional Outbox & Idempotent Event Consumer ---

model OutboxEvent {
  id            String    @id @default(uuid()) @db.Uuid
  eventType     String    @map("event_type") @db.VarChar(128)
  eventVersion  Int       @default(1) @map("event_version")
  aggregateId   String    @map("aggregate_id") @db.VarChar(128)
  correlationId String    @map("correlation_id") @db.VarChar(128)
  payload       Json
  status        String    @default("PENDING") @db.VarChar(32)
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz
  publishedAt   DateTime? @map("published_at") @db.Timestamptz
  lastError     String?   @map("last_error") @db.Text
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([status, nextAttemptAt])
  @@map("outbox_events")
}

model ProcessedEvent {
  eventId     String   @id @map("event_id") @db.VarChar(128)
  eventType   String   @map("event_type") @db.VarChar(128)
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz

  @@map("processed_events")
}

// --- Operations, Support, CMS, Flags, Webhooks & Governance ---

model SupportTicket {
  id            String           @id @db.VarChar(64)
  tenantId      String?          @map("tenant_id") @db.VarChar(64)
  tenant        Tenant?          @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  requesterName String           @map("requester_name") @db.VarChar(128)
  requesterEmail String          @map("requester_email") @db.VarChar(255)
  subject       String           @db.VarChar(255)
  category      String           @db.VarChar(64)
  priority      String           @default("MEDIUM") @db.VarChar(32)
  status        String           @default("OPEN") @db.VarChar(32)
  assignedAgent String?          @map("assigned_agent") @db.VarChar(128)
  relatedJobId  String?          @map("related_job_id") @db.VarChar(64)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  messages      SupportMessage[]

  @@index([tenantId, status])
  @@map("support_tickets")
}

model SupportMessage {
  id         String        @id @default(uuid()) @db.Uuid
  ticketId   String        @map("ticket_id") @db.VarChar(64)
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender     String        @db.VarChar(128)
  senderRole String        @map("sender_role") @db.VarChar(64)
  body       String        @db.Text
  internal   Boolean       @default(false)
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz

  @@index([ticketId, createdAt])
  @@map("support_messages")
}

model Notification {
  id            String       @id @default(uuid()) @db.Uuid
  userProfileId String?      @map("user_profile_id") @db.Uuid
  userProfile   UserProfile? @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
  tenantId      String?      @map("tenant_id") @db.VarChar(64)
  channel       String       @default("IN_APP") @db.VarChar(32)
  title         String       @db.VarChar(255)
  body          String       @db.Text
  readAt        DateTime?    @map("read_at") @db.Timestamptz
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz

  @@index([tenantId, createdAt])
  @@map("notifications")
}

model CmsContent {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique @db.VarChar(128)
  type      String   @db.VarChar(64)
  title     String   @db.VarChar(255)
  summary   String?  @db.Text
  body      Json?
  status    String   @default("PUBLISHED") @db.VarChar(32)
  sortOrder Int      @default(0) @map("sort_order")
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("cms_contents")
}

model FeatureFlag {
  key           String                  @id @db.VarChar(64)
  name          String                  @db.VarChar(128)
  description   String                  @db.Text
  owner         String                  @db.VarChar(64)
  globalEnabled Boolean                 @default(false) @map("global_enabled")
  rolloutPct    Int                     @default(100) @map("rollout_pct")
  updatedAt     DateTime                @updatedAt @map("updated_at") @db.Timestamptz

  overrides     TenantFeatureOverride[]

  @@map("feature_flags")
}

model TenantFeatureOverride {
  tenantId   String      @map("tenant_id") @db.VarChar(64)
  featureKey String      @map("feature_key") @db.VarChar(64)
  enabled    Boolean
  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  flag       FeatureFlag @relation(fields: [featureKey], references: [key], onDelete: Cascade)

  @@id([tenantId, featureKey])
  @@map("tenant_feature_overrides")
}

model WebhookEndpoint {
  id               String            @id @default(uuid()) @db.Uuid
  tenantId         String?           @map("tenant_id") @db.VarChar(64)
  tenant           Tenant?           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  url              String            @db.Text
  events           Json              @default("[]")
  secretHash       String?           @map("secret_hash") @db.VarChar(128)
  active           Boolean           @default(true)
  lastResponseCode Int?              @map("last_response_code")
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz

  deliveries       WebhookDelivery[]

  @@map("webhook_endpoints")
}

model WebhookDelivery {
  id           String          @id @default(uuid()) @db.Uuid
  endpointId   String          @map("endpoint_id") @db.Uuid
  endpoint     WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  eventType    String          @map("event_type") @db.VarChar(64)
  statusCode   Int             @map("status_code")
  attemptCount Int             @default(1) @map("attempt_count")
  deliveredAt  DateTime        @default(now()) @map("delivered_at") @db.Timestamptz

  @@map("webhook_deliveries")
}

model DataGovernanceRequest {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @map("tenant_id") @db.VarChar(64)
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type              String   @db.VarChar(32)
  requester         String   @db.VarChar(255)
  status            String   @default("PENDING_REVIEW") @db.VarChar(32)
  retentionDeadline DateTime @map("retention_deadline") @db.Timestamptz
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("data_governance_requests")
}

model SystemSetting {
  key       String   @id @db.VarChar(64)
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("system_settings")
}
