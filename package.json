    "@fastify/swagger": "^9.9.3",
    "@fastify/swagger-ui": "^6.1.3",
    "@neondatabase/serverless": "^0.10.4",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "amqplib": "^2.3.1",
    "cloudinary": "^2.5.1",
    "fastify": "^5.2.0",
    "ioredis": "^6.0.0",
    "nodemailer": "^10.5.0",
    "pg": "^8.13.1",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/node": "^22.10.1",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.11.10",
    "prisma": "^7.10.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^5.1.0"
  }
