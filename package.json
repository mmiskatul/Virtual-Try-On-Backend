  "description": "Unified Fastify 5 Enterprise Backend for Virtual Try-On SaaS (Brand, Marketplace, Super Admin)",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/index.js",
    "worker": "node dist/worker.js",
    "start:ts": "tsx src/index.ts",
    "test": "tsx test/backend.test.ts",
    "test:unit": "vitest run",
    "test:auth": "tsx test/auth.test.ts",
    "test:security": "tsx test/security.test.ts",
    "test:prisma": "tsx test/prisma.test.ts",
    "test:quota": "tsx test/tenant_quota.test.ts",
    "test:signin": "tsx test/signin_signup.test.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
